rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // User documents & profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['elo', 'level', 'xp', 'certificatesCount', 'verifiedSkills']);
      allow delete: if isAdmin();
    }

    // Public Profiles
    match /profiles/{username} {
      allow read: if true; // Public shareable profile: skillarena.app/@username
      allow write: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Tournaments & Brackets
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAuthenticated(); // Registered organizers
      allow update: if isAdmin() || (isAuthenticated() && resource.data.organizerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Guilds & Clans
    match /guilds/{guildId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.leaderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Persistent AI Conversations & Chat Messages
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Verified Certificates & ELO Records (Immutable by clients)
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin(); // Lock SHA-256 certificate generation to backend admin SDK
    }
  }
}
